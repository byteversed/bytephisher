root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yaml,yml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[templates/**]
# generated pages keep their own formatting
insert_final_newline = false
trim_trailing_whitespace = false
